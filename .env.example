# Frontend: leave empty for local development (Vite proxies /api to port 8000).
# Set to your deployed FastAPI service URL in Vercel, without a trailing slash.
VITE_API_BASE_URL=

# Backend (copy this file to .env for local development).
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FIREBASE_PROJECT_ID=
# Prefer workload identity / Application Default Credentials in production.
# For local development, provide the service account JSON as a secret environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional public GitHub API token to increase API rate limits.
GITHUB_TOKEN=
