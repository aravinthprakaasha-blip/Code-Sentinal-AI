# CodeSentry AI environment template.
# Copy to .env (backend + frontend) or .env.local (frontend overrides) and fill in values.
# NEVER put real secrets in this file: it is committed to Git.

# ---------------------------------------------------------------------------
# Frontend (Vite). VITE_* values are embedded in the public JavaScript bundle,
# so only put PUBLIC values here. Never put Gemini, GitHub, or Firebase Admin
# credentials in a VITE_* variable.
# ---------------------------------------------------------------------------
# Leave empty for local development (Vite proxies /api to port 8000).
# In Vercel, set it to the deployed API URL without a trailing slash.
VITE_API_BASE_URL=

# Firebase Web App config (public by design; Firebase Console > Project settings > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Leave empty to use the "(default)" Firestore database.
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# ---------------------------------------------------------------------------
# Backend (FastAPI). These are server-side secrets and settings.
# ---------------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Must be the same Firebase project as VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
# Either a path to the service-account JSON file (relative to the repo root),
# e.g. secrets/firebase-service-account.json, or the JSON itself on one line.
# On Render, paste the JSON as a secret environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: enables Gemini AI review. Create in Google AI Studio.
GEMINI_API_KEY=
# gemini-2.5-flash is restricted to accounts that used it before; new keys should use a 3.x model.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60

# Optional: raises GitHub API rate limits for PUBLIC repositories. It is never used to
# read private repositories (users supply their own token per scan for that).
# Use a fine-grained token with no repository permissions ("Public repositories (read-only)").
GITHUB_TOKEN=

# Optional scan limits (defaults shown).
MAX_REPOSITORY_FILES=1000
MAX_SOURCE_FILE_BYTES=500000
MAX_REPOSITORY_BYTES=30000000
REPOSITORY_TIMEOUT_SECONDS=120
DEPENDENCY_SCAN_ENABLED=true
RATE_LIMIT_ANALYSIS_PER_MINUTE=6
RATE_LIMIT_AI_PER_MINUTE=20
